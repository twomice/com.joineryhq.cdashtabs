{
    "name": "joineryhq/cdashtabs",
    "description": "Divides the Contact Dashboard into tabs for ease of use. Also allows display of profiles as read-only tabs in the Contact Dashboard.",
    "type": "civicrm-ext",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Allen Shaw",
            "email": "allen@joineryhq.com"
        }
    ],
    "support": {
        "issues": "https://github.com/twomice/com.joineryhq.cdashtabs/issues",
        "source": "https://github.com/twomice/com.joineryhq.cdashtabs"
    },
    "require": {
        "composer/installers": "^1.0 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Civi\\": "Civi/"
        },
        "psr-0": {
            "CRM_": "./"
        }
    },
    "extra": {
        "civicrm-ext-key": "com.joineryhq.cdashtabs"
    }
}
